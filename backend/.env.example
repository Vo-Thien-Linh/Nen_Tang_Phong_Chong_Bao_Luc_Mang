# Copy this file to backend/.env and replace the placeholders.
# Generate a JWT key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_NAME=NexusSocial
SMTP_FROM_EMAIL=replace-me@example.com
