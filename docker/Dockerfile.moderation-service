FROM node:22-alpine

WORKDIR /app
COPY package.json ./package.json
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --omit=dev --prefix backend
RUN ln -s /app/backend/node_modules /app/node_modules
COPY shared ./shared
COPY backend/src ./backend/src
COPY services/moderation-service/src ./services/moderation-service/src
COPY services/moderation-service/server.js ./services/moderation-service/server.js

ENV NODE_ENV=production
ENV MODERATION_SERVICE_PORT=5003
EXPOSE 5003
CMD ["node", "services/moderation-service/server.js"]
