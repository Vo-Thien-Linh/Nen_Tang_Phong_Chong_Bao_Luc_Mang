FROM node:22-alpine

WORKDIR /app
COPY package.json ./package.json
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --omit=dev --prefix backend
RUN ln -s /app/backend/node_modules /app/node_modules
COPY shared ./shared
COPY backend/src ./backend/src
COPY services/notification-service/src ./services/notification-service/src
COPY services/notification-service/server.js ./services/notification-service/server.js

ENV NODE_ENV=production
ENV NOTIFICATION_SERVICE_PORT=5004
EXPOSE 5004
CMD ["node", "services/notification-service/server.js"]
