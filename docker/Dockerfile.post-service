FROM node:22-alpine

WORKDIR /app
COPY package.json ./package.json
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --omit=dev --prefix backend
RUN ln -s /app/backend/node_modules /app/node_modules
COPY shared ./shared
COPY backend/src ./backend/src
COPY services/post-service/src ./services/post-service/src
COPY services/post-service/server.js ./services/post-service/server.js

ENV NODE_ENV=production
ENV POST_SERVICE_PORT=5002
EXPOSE 5002
CMD ["node", "services/post-service/server.js"]
