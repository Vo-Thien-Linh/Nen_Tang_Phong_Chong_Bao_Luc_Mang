FROM node:22-alpine

WORKDIR /app
COPY package.json ./package.json
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --omit=dev --prefix backend
RUN ln -s /app/backend/node_modules /app/node_modules
COPY backend/src/config/db.js ./backend/src/config/db.js
COPY backend/src/middleware/auth.js ./backend/src/middleware/auth.js
COPY backend/src/repositories/userRepository.js ./backend/src/repositories/userRepository.js
COPY backend/src/services/imageModerationResponse.js ./backend/src/services/imageModerationResponse.js
COPY backend/src/services/moderationNotificationText.js ./backend/src/services/moderationNotificationText.js
COPY backend/src/services/trustScoreService.js ./backend/src/services/trustScoreService.js
COPY backend/src/utils/rbac.js ./backend/src/utils/rbac.js
COPY services/user-service/src ./services/user-service/src
COPY services/user-service/server.js ./services/user-service/server.js

ENV NODE_ENV=production
ENV USER_SERVICE_PORT=5001
EXPOSE 5001
CMD ["node", "services/user-service/server.js"]
